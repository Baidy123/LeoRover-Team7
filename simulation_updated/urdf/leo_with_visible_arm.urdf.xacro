<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="leo_with_visible_arm">
  
  <!-- Include official Leo Rover base -->
  <xacro:include filename="$(find leo_description)/urdf/leo_sim.urdf.xacro"/>
  
  <!-- ═══════════════════════════════════════════
       REDESIGNED ARM — longer reach + parallel gripper
       Total reach: ~0.55m horizontal when fully extended
       ═══════════════════════════════════════════ -->

  <!-- Arm base platform — wider turntable -->
  <link name="arm_platform">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.05"/></geometry>
      <material name="platform_color"><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 0.025"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="arm_platform_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_platform"/>
    <origin xyz="0.0 0 0.11" rpy="0 0 0"/>
  </joint>

  <!-- Segment 1 — lower arm (longer, 0.28m) — rotates around Z (pan) -->
  <link name="arm_segment1">
    <visual>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.28"/></geometry>
      <material name="arm_color"><color rgba="0.1 0.3 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.28"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 0.14"/>
      <inertia ixx="0.002" iyy="0.002" izz="0.00006" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="arm_segment1_joint" type="revolute">
    <parent link="arm_platform"/>
    <child link="arm_segment1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>

  <!-- Segment 2 — upper arm (0.28m) — rotates around Y (shoulder pitch) -->
  <link name="arm_segment2">
    <visual>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.28"/></geometry>
      <material name="arm_color"><color rgba="0.1 0.3 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.28"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.14"/>
      <inertia ixx="0.0015" iyy="0.0015" izz="0.00004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="arm_segment2_joint" type="revolute">
    <parent link="arm_segment1"/>
    <child link="arm_segment2"/>
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>

  <!-- Forearm — wrist link (0.18m) — rotates around Y (elbow) -->
  <link name="arm_forearm">
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.18"/></geometry>
      <material name="arm_color"><color rgba="0.1 0.3 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.18"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0.09"/>
      <inertia ixx="0.0005" iyy="0.0005" izz="0.00003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="arm_forearm_joint" type="revolute">
    <parent link="arm_segment2"/>
    <child link="arm_forearm"/>
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="3.0" velocity="1.0"/>
    <dynamics damping="0.4" friction="0.15"/>
  </joint>

  <!-- Gripper base — palm -->
  <link name="arm_gripper">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.06 0.07 0.04"/></geometry>
      <material name="gripper_color"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.06 0.07 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0.03"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="arm_gripper_joint" type="revolute">
    <parent link="arm_forearm"/>
    <child link="arm_gripper"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="2.0" velocity="1.0"/>
    <dynamics damping="0.3" friction="0.1"/>
  </joint>

  <!-- Left finger -->
  <link name="finger_left">
    <visual>
      <origin xyz="0 0.035 0.05" rpy="0 0 0"/>
      <geometry><box size="0.015 0.012 0.08"/></geometry>
      <material name="finger_color"><color rgba="0.8 0.4 0.0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0.035 0.05" rpy="0 0 0"/>
      <geometry><box size="0.015 0.012 0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <origin xyz="0 0.035 0.05"/>
      <inertia ixx="0.00003" iyy="0.00003" izz="0.000005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="finger_left_joint" type="prismatic">
    <parent link="arm_gripper"/>
    <child link="finger_left"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.03" upper="0.03" effort="5.0" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Right finger -->
  <link name="finger_right">
    <visual>
      <origin xyz="0 -0.035 0.05" rpy="0 0 0"/>
      <geometry><box size="0.015 0.012 0.08"/></geometry>
      <material name="finger_color"><color rgba="0.8 0.4 0.0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 -0.035 0.05" rpy="0 0 0"/>
      <geometry><box size="0.015 0.012 0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <origin xyz="0 -0.035 0.05"/>
      <inertia ixx="0.00003" iyy="0.00003" izz="0.000005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="finger_right_joint" type="prismatic">
    <parent link="arm_gripper"/>
    <child link="finger_right"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.03" upper="0.03" effort="5.0" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- CRITICAL: Gazebo tags to make arm visible in simulation -->
  
  <gazebo reference="arm_platform">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="arm_segment1">
    <material>Gazebo/Blue</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="arm_segment2">
    <material>Gazebo/Blue</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="arm_forearm">
    <material>Gazebo/Blue</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="arm_gripper">
    <material>Gazebo/DarkGrey</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="finger_left">
    <material>Gazebo/Orange</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="finger_right">
    <material>Gazebo/Orange</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- Depth Camera Link -->
  <link name="depth_camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.1 0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.1 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Depth Camera Joint -->
  <joint name="depth_camera_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="depth_camera_link"/>
    <origin xyz="0.15 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Depth Camera Sensor -->
  <gazebo reference="depth_camera_link">
    <material>Gazebo/Black</material>
    <sensor name="depth_camera" type="rgbd_camera">
      <camera name="depth_camera">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
        <depth_camera>
          <output>depths</output>
        </depth_camera>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>depth_camera</topic>
      <gz_frame_id>depth_camera_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- NOTE: ros2_control block removed until gz_ros2_control is confirmed installed.
       Run: sudo apt install ros-jazzy-gz-ros2-control
       Then restore the ros2_control block from the README. -->


  <!-- Joint position controllers for all arm joints + fingers -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm_segment1_joint</joint_name>
      <topic>/model/leo/joint/arm_segment1_joint/cmd_pos</topic>
      <p_gain>20.0</p_gain><i_gain>0.1</i_gain><d_gain>1.0</d_gain>
      <i_max>5</i_max><i_min>-5</i_min><cmd_max>20</cmd_max><cmd_min>-20</cmd_min>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm_segment2_joint</joint_name>
      <topic>/model/leo/joint/arm_segment2_joint/cmd_pos</topic>
      <p_gain>20.0</p_gain><i_gain>0.1</i_gain><d_gain>1.0</d_gain>
      <i_max>5</i_max><i_min>-5</i_min><cmd_max>20</cmd_max><cmd_min>-20</cmd_min>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm_forearm_joint</joint_name>
      <topic>/model/leo/joint/arm_forearm_joint/cmd_pos</topic>
      <p_gain>15.0</p_gain><i_gain>0.1</i_gain><d_gain>0.8</d_gain>
      <i_max>3</i_max><i_min>-3</i_min><cmd_max>15</cmd_max><cmd_min>-15</cmd_min>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm_gripper_joint</joint_name>
      <topic>/model/leo/joint/arm_gripper_joint/cmd_pos</topic>
      <p_gain>10.0</p_gain><i_gain>0.05</i_gain><d_gain>0.5</d_gain>
      <i_max>2</i_max><i_min>-2</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>finger_left_joint</joint_name>
      <topic>/model/leo/joint/finger_left_joint/cmd_pos</topic>
      <p_gain>50.0</p_gain><i_gain>0.1</i_gain><d_gain>1.0</d_gain>
      <i_max>5</i_max><i_min>-5</i_min><cmd_max>50</cmd_max><cmd_min>-50</cmd_min>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>finger_right_joint</joint_name>
      <topic>/model/leo/joint/finger_right_joint/cmd_pos</topic>
      <p_gain>50.0</p_gain><i_gain>0.1</i_gain><d_gain>1.0</d_gain>
      <i_max>5</i_max><i_min>-5</i_min><cmd_max>50</cmd_max><cmd_min>-50</cmd_min>
    </plugin>
  </gazebo>


  <!-- ═══════════════════════════════════════════════════════════
       DetachableJoint plugins — one per pickup-able box
       Attach:  gz topic -t /box/red_box_1/attach  -m gz.msgs.Empty -p ""
       Detach:  gz topic -t /box/red_box_1/detach  -m gz.msgs.Empty -p ""
       ═══════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>arm_gripper</parent_link>
      <child_model>red_box_1</child_model>
      <child_link>link</child_link>
      <attach_topic>/box/red_box_1/attach</attach_topic>
      <detach_topic>/box/red_box_1/detach</detach_topic>
      <output_topic>/box/red_box_1/state</output_topic>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>arm_gripper</parent_link>
      <child_model>red_box_2</child_model>
      <child_link>link</child_link>
      <attach_topic>/box/red_box_2/attach</attach_topic>
      <detach_topic>/box/red_box_2/detach</detach_topic>
      <output_topic>/box/red_box_2/state</output_topic>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>arm_gripper</parent_link>
      <child_model>blue_box_1</child_model>
      <child_link>link</child_link>
      <attach_topic>/box/blue_box_1/attach</attach_topic>
      <detach_topic>/box/blue_box_1/detach</detach_topic>
      <output_topic>/box/blue_box_1/state</output_topic>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>arm_gripper</parent_link>
      <child_model>blue_box_2</child_model>
      <child_link>link</child_link>
      <attach_topic>/box/blue_box_2/attach</attach_topic>
      <detach_topic>/box/blue_box_2/detach</detach_topic>
      <output_topic>/box/blue_box_2/state</output_topic>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>arm_gripper</parent_link>
      <child_model>green_box_1</child_model>
      <child_link>link</child_link>
      <attach_topic>/box/green_box_1/attach</attach_topic>
      <detach_topic>/box/green_box_1/detach</detach_topic>
      <output_topic>/box/green_box_1/state</output_topic>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>arm_gripper</parent_link>
      <child_model>green_box_2</child_model>
      <child_link>link</child_link>
      <attach_topic>/box/green_box_2/attach</attach_topic>
      <detach_topic>/box/green_box_2/detach</detach_topic>
      <output_topic>/box/green_box_2/state</output_topic>
    </plugin>
  </gazebo>
</robot>
