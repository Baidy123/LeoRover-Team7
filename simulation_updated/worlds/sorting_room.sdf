    <!-- BIN — drop target -->
    <model name="bin">
      <static>true</static>
      <pose>2.0 0.0 0 0 0 0</pose>
      <link name="floor">
        <pose>0 0 0.01 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.4 0.4 0.02</size></box></geometry></collision>
        <visual name="vis">
