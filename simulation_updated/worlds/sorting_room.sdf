    <!-- Blue box 1 — on obstacle_6 -->
    <model name="blue_box_1">
      <static>false</static>
      <pose>-0.8 -0.8 0.55 0 0 0</pose>
      <static>true</static>
      <link name="link">
        
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00017</ixx><ixy>0</ixy><ixz>0</ixz>
