    <!-- Obstacle 5 - Middle right -->
    <model name="obstacle_5">
      <pose>1.3 -0.5 0.35 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.35 0.35 0.7</size></box>
