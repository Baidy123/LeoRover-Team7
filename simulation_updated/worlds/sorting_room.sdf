    <!-- ==================== RED BOXES ON OBSTACLES ==================== -->
    
    <!-- Red box 1 - ON TOP OF CENTER OBSTACLE -->
    <model name="red_box_1">
      <static>false</static>
      <pose>0.0 0.0 0.9 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00017</ixx>
            <iyy>0.00017</iyy>
            <izz>0.00017</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red box 2 - ON TOP OF OBSTACLE 2 (near red basket) -->
    <model name="red_box_2">
      <static>false</static>
      <pose>1.5 1.2 0.775 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00017</ixx>
            <iyy>0.00017</iyy>
            <izz>0.00017</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
