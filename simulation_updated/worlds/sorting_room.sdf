          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 4 - Near blue basket -->
    <model name="obstacle_4">
      <pose>-1.2 -1.3 0.3 0 0 0</pose>
      <static>true</static>
