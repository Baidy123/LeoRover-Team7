    </model>

    <!-- Obstacle 2 - Near red basket -->
    <model name="obstacle_2">
      <pose>1.5 1.2 0.1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.35 0.35 0.075</size></box>
