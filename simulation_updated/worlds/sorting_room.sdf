    <!-- Obstacle 7 - Near entrance area -->
    <model name="obstacle_7">
      <pose>0.7 1.5 0.3 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.3 0.3 0.6</size></box>
