<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="leo_with_visible_arm_and_pillars">
  
  <!-- Include official Leo Rover base -->
  <xacro:include filename="$(find leo_description)/urdf/leo_sim.urdf.xacro"/>
  
  <!-- ========================================= -->
  <!-- PILLARS FOR LIDAR COMPARISON TEST -->
  <!-- ========================================= -->
  
  <!-- Pillar Parameters - EASILY ADJUSTABLE -->
  <xacro:property name="pillar_height" value="0.30" />  <!-- 30cm tall -->
  <xacro:property name="pillar_radius" value="0.015" />  <!-- 3cm diameter -->
  <xacro:property name="pillar_mass" value="0.1" />      <!-- 100g each -->
  
  <!-- Pillar positions (at rover corners) -->
  <xacro:property name="pillar_offset_x" value="0.15" />  
  <xacro:property name="pillar_offset_y" value="0.11" />
  
  <!-- Pillar Macro -->
  <xacro:macro name="pillar" params="name x y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${pillar_height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${pillar_radius}" length="${pillar_height}"/>
        </geometry>
        <material name="pillar_gray">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      
      <collision>
        <origin xyz="0 0 ${pillar_height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${pillar_radius}" length="${pillar_height}"/>
        </geometry>
      </collision>
      
      <inertial>
        <origin xyz="0 0 ${pillar_height/2}" rpy="0 0 0"/>
        <mass value="${pillar_mass}"/>
        <inertia ixx="0.0008" iyy="0.0008" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0.0" rpy="0 0 0"/>
    </joint>
    
    <!-- Gazebo material for pillars -->
    <gazebo reference="${name}">
      <material>Gazebo/Grey</material>
      <selfCollide>false</selfCollide>
    </gazebo>
  </xacro:macro>
  
  <!-- Create 4 Pillars at Corners -->
  <xacro:pillar name="pillar_front_left"  x="${pillar_offset_x}"  y="${pillar_offset_y}"/>
  <xacro:pillar name="pillar_front_right" x="${pillar_offset_x}"  y="${-pillar_offset_y}"/>
  <xacro:pillar name="pillar_rear_left"   x="${-pillar_offset_x}" y="${pillar_offset_y}"/>
  <xacro:pillar name="pillar_rear_right"  x="${-pillar_offset_x}" y="${-pillar_offset_y}"/>
  
  <!-- ========================================= -->
  <!-- ORIGINAL ARM (unchanged) -->
  <!-- ========================================= -->
  
  <!-- Arm base platform -->
  <link name="arm_platform">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="platform_color">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.02"/>
      <inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="arm_platform_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_platform"/>
    <origin xyz="0 0 0.11" rpy="0 0 0"/>
  </joint>

  <!-- Arm segment 1 (vertical blue cylinder) -->
  <link name="arm_segment1">
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.16"/>
      </geometry>
      <material name="arm_color">
        <color rgba="0.1 0.3 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.16"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.08"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.00005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="arm_segment1_joint" type="revolute">
    <parent link="arm_platform"/>
    <child link="arm_segment1"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="1.5" velocity="1.0"/>
    <dynamics damping="0.3" friction="0.2"/>
  </joint>

  <!-- Arm segment 2 (angled blue box) -->
  <link name="arm_segment2">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.035 0.12"/>
      </geometry>
      <material name="arm_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.035 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0.06"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.00003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="arm_segment2_joint" type="revolute">
    <parent link="arm_segment1"/>
    <child link="arm_segment2"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="1.5" velocity="1.0"/>
    <dynamics damping="0.3" friction="0.2"/>
  </joint>

  <!-- End effector / gripper -->
  <link name="arm_gripper">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.06 0.05"/>
      </geometry>
      <material name="gripper_color">
        <color rgba="0.15 0.15 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.06 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0.025"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.00005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="arm_gripper_joint" type="fixed">
    <parent link="arm_segment2"/>
    <child link="arm_gripper"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- CRITICAL: Gazebo tags to make arm visible in simulation -->
  
  <gazebo reference="arm_platform">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="arm_segment1">
    <material>Gazebo/Blue</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="arm_segment2">
    <material>Gazebo/Blue</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="arm_gripper">
    <material>Gazebo/Black</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- Depth Camera Link -->
  <link name="depth_camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.1 0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.1 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Depth Camera Joint -->
  <joint name="depth_camera_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="depth_camera_link"/>
    <origin xyz="0.15 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Depth Camera Sensor -->
  <gazebo reference="depth_camera_link">
    <material>Gazebo/Black</material>
    <sensor name="depth_camera" type="rgbd_camera">
      <camera name="depth_camera">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
        <depth_camera>
          <output>depths</output>
        </depth_camera>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>depth_camera</topic>
      <gz_frame_id>depth_camera_link</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
