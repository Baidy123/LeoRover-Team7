Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Reference Frame: map
      
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: true
      
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic: /scan
      Size: 0.03
      Style: Points
      Color: 255; 255; 255
      Decay Time: 0
      
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic: /map
      Color Scheme: map
      
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Topic: /plan
      Color: 255; 0; 0
      
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Topic: /local_plan
      Color: 0; 255; 0
      
    - Class: rviz_default_plugins/Image
      Name: Camera
      Topic: /camera/color/image_raw
      
  Global Options:
    Fixed Frame: map
    
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
