python

def generate_launch_description():
    """
    NUC launch file - assumes Pi is already running Leo base
    """
    
    return LaunchDescription([
        # Pi is already running leo_bringup!
        # Just use its /odom and /cmd_vel topics
        
        # LiDAR (connected to NUC)
        Node(
            package='rplidar_ros',
            executable='rplidar_node',
            parameters=[{
                'serial_port': '/dev/ttyUSB0',
                'frame_id': 'laser_frame'
            }]
        ),
        
        # Camera (connected to NUC)
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource([
                get_package_share_directory('realsense2_camera'),
                '/launch/rs_launch.py'
            ])
        ),
        
        # SLAM on NUC
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource([
                get_package_share_directory('slam_toolbox'),
                '/launch/online_async_launch.py'
            ]),
            launch_arguments={
                'slam_params_file': 'path/to/slam_params_real.yaml'
            }.items()
        ),
        
        # TF publishers
        # ... (LiDAR, camera TFs)
    ])

