3. Find device named "LeoRover" or "raspberrypi"
4. Note the IP (e.g., 192.168.1.147)

Option B: Use network scanner
bash

# Install nmap
sudo apt install nmap

# Scan your network (adjust subnet!)
nmap -sn 192.168.1.0/24

# Look for something like:
# Nmap scan report for 192.168.1.147
# Host is up (0.0012s latency).
# MAC Address: B8:27:EB:XX:XX:XX (Raspberry Pi Foundation)

Option C: Connect direct first, then configure WiFi
bash

# 1. Connect to Leo's hotspot
ssh pi@10.0.0.1

# 2. Configure WiFi on rover
sudo raspi-config
# Select: System Options → Wireless LAN
# Enter your WiFi SSID and password

# 3. Reboot
sudo reboot

# 4. Find new IP using method A or B above

