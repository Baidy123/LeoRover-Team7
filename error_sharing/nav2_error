    package='tf2_ros',
    executable='static_transform_publisher',
    name='laser_tf',
    arguments=['0.05', '0.0', '0.25', '0', '0', '0',  # ← YOUR VALUES!
              #   X      Y      Z     roll pitch yaw
              'base_link', 'laser_frame'],
)

# Camera TF - UPDATE WITH YOUR MEASUREMENTS!
