<?xml version="1.0"?>
<package format="3">
  <name>leo_lidar_sim</name>
  <version>1.0.0</version>
  <description>Leo Rover autonomous navigation with vision and SLAM</description>
  
  <maintainer email="student@example.com">Student31</maintainer>
  <license>MIT</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 Core -->
  <depend>rclpy</depend>
  <depend>rclcpp</depend>
  
  <!-- Messages -->
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  
  <!-- TF -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  
  <!-- Vision -->
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  
  <!-- SLAM & Navigation -->
  <depend>slam_toolbox</depend>
  <depend>nav2_bringup</depend>
  <depend>nav2_common</depend>
  <depend>navigation2</depend>
  
  <!-- Sensors -->
  <depend>rplidar_ros</depend>
  <depend>realsense2_camera</depend>
  
  <!-- Leo Rover -->
  <depend>leo_bringup</depend>
  <depend>leo_description</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
