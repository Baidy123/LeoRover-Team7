<link name="lidar_link">
  <pose relative_to="base_link">0.15 0 0.15 0 0 0</pose>
  <inertial>
    <mass>0.19</mass>  
    <inertia>
      <ixx>0.0001</ixx>
      <iyy>0.0001</iyy>
      <izz>0.0001</izz>
    </inertia>
  </inertial>
  
  <collision name="collision">
    <geometry>
      <cylinder>
        <radius>0.038</radius>
        <length>0.040</length>
      </cylinder>
    </geometry>
  </collision>
  
  <visual name="visual">
    <geometry>
      <cylinder>
        <radius>0.038</radius>
        <length>0.040</length>
      </cylinder>
    </geometry>
    <material>
      <ambient>0.1 0.1 0.1 1</ambient>
      <diffuse>0.2 0.2 0.2 1</diffuse>
    </material>
  </visual>
  
  <!-- RPLiDAR A2M12 -->
  <sensor name="rplidar_a2" type="gpu_lidar">
    <update_rate>10</update_rate>
    <topic>scan</topic>
    <lidar>
      <scan>
        <horizontal>
          <samples>400</samples>
          <resolution>1</resolution>
          <min_angle>0</min_angle>
          <max_angle>6.28319</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.15</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
    </lidar>
    <always_on>1</always_on>
    <visualize>true</visualize>
  </sensor>
</link>
